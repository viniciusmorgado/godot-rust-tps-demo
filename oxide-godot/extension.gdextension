[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../oxide_godot_core/target/debug/liboxide_godot.so"
linux.release.x86_64 =   "res://../oxide_godot_core/target/release/liboxide_godot.so"
windows.debug.x86_64 =   "res://../oxide_godot_core/target/debug/oxide_godot.dll"
windows.release.x86_64 = "res://../oxide_godot_core/target/release/oxide_godot.dll"
macos.debug =            "res://../oxide_godot_core/target/debug/liboxide_godot.dylib"
macos.release =          "res://../oxide_godot_core/target/release/liboxide_godot.dylib"
macos.debug.arm64 =      "res://../oxide_godot_core/target/debug/liboxide_godot.dylib"
macos.release.arm64 =    "res://../oxide_godot_core/target/release/liboxide_godot.dylib"
